# ============================================================
# Local podman/docker-compose environment.
# Generated for local dev only — safe to commit is still NO,
# but these secrets are meaningless outside your own machine.
# ============================================================

APP_NAME=Kubernetes Optimization Platform
API_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Database — local Postgres container (service name: postgres) ─────────
DATABASE_URL=postgresql://k8sopt:k8sopt_local_dev@postgres:5432/k8sopt
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis / Celery — local Redis container (service name: redis) ─────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Kubernetes ────────────────────────────────────────────────
# No real cluster required to browse the dashboard locally. If you want to
# register a real (or local kind/minikube) cluster's agent against this
# backend, that happens via the agent's PLATFORM_URL/API_TOKEN — it does
# NOT need a kubeconfig mounted into the backend container itself.
K8S_IN_CLUSTER=false
K8S_CONFIG_PATH=/root/.kube/config
K8S_CONTEXT=

# ── Security — generated locally, unique to this machine ─────────────────
SECRET_KEY=WS4Hp68OEYOrWSFv_B-DUcmgRPZ0MWKPR_mylFQmHmRjvwpjdsQ8CP2C1tUn-izg
JWT_SECRET_KEY=QGadwZgeuu_GDaEyuDm6wQzwHg0vctpM1AGvfpHGcQRqDrg1bxNKYmDIY9H6zxdI
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Used to mint per-cluster agent tokens via POST /api/tokens/generate
ADMIN_TOKEN=LdIZyFZtciB4xY9bWKqZFBVSwSrGfvnTWRCOxHDHWfY

# ── OpenAI (optional — leave blank to disable AI Copilot features) ───────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000

# ── CORS — local frontend origins ─────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:8000

# ── Cost Calculation (matches backend/utils/cost_engine.py) ──────────────
CPU_COST_PER_CORE_HOUR=0.031
MEMORY_COST_PER_GB_HOUR=0.004
STORAGE_COST_PER_GB_MONTH=0.10

# ── Carbon Footprint ─────────────────────────────────────────
CARBON_PER_KWH=0.35
CPU_WATTS_PER_CORE=10.0
MEMORY_WATTS_PER_GB=0.375

# ── Optimization ─────────────────────────────────────────────
CPU_BUFFER_PERCENTAGE=20.0
MEMORY_BUFFER_PERCENTAGE=20.0
MIN_RECOMMENDATION_CONFIDENCE=0.7
LOOKBACK_DAYS=7

# ── Auto-fix — dry-run by default even locally ────────────────────────────
AUTO_FIX_ENABLED=false
AUTO_FIX_DRY_RUN=true
AUTO_FIX_MAX_BATCH_SIZE=10

# ── Cleanup ──────────────────────────────────────────────────
CLEANUP_UNUSED_DAYS=90
CLEANUP_SAFE_DELETE_ENABLED=true

# ── Monitoring ───────────────────────────────────────────────
PROMETHEUS_URL=http://prometheus:9090
METRICS_COLLECTION_INTERVAL=300

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
